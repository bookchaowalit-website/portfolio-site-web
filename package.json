{
  "name": "bookchaowalit-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "check:github": "node ./scripts/check-github.mjs",
    "mcp:test": "node ./scripts/test-mithub.mjs",
    "mcp:dev": "NODE_ENV=development node ./scripts/test-github.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:data-products": "playwright test e2e/data-products-walkthrough.spec.ts --project=chromium",
    "e2e:a11y": "playwright test e2e/keyboard-help.spec.ts e2e/home.spec.ts e2e/navigation.spec.ts e2e/locale-theme.spec.ts --project=chromium",
    "lhci": "lhci autorun",
    "lhci:ci": "lhci autorun --config=lighthouserc.ci.json",
    "test:data-products": "node --experimental-strip-types --test src/lib/data-products/__tests__/**/*.test.ts",
    "test:portfolio": "node --experimental-strip-types --test src/data/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ci:local": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:a11y": "playwright test e2e/a11y-axe.spec.ts --project=chromium",
    "test": "npm run test:data-products && npm run test:portfolio && npm run test:lib",
    "test:lib": "node --experimental-strip-types --test src/lib/__tests__/*.test.ts",
    "audit:links": "node --experimental-strip-types scripts/live-link-audit.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@next/mdx": "^15.5.20",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.75.2",
    "@serwist/next": "^9.5.11",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "framer-motion": "^12.23.12",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.542.0",
    "next": "^15.5.28",
    "next-intl": "^4.3.5",
    "next-mdx-remote": "^6.0.0",
    "posthog-js": "1.438.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reading-time": "^1.5.0",
    "resend": "^6.0.3",
    "serwist": "^9.5.11",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@swc/helpers": "^0.5.23"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "@serwist/build": {
      "zod": "$zod"
    },
    "@serwist/next": {
      "zod": "$zod"
    },
    "@serwist/webpack-plugin": {
      "zod": "$zod"
    }
  }
}
